# Copiar este archivo a .env y completar los valores reales.
# NUNCA commitear .env ni subir secretos al repositorio.

# --- Supabase (proyecto nuevo o existente) ---
# URL pública del proyecto (Settings > API). No es secreta.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave anónima pública del navegador (Settings > API).
# Las operaciones sensibles se hacen en Edge Functions con service roles/secrets.
VITE_SUPABASE_ANON_KEY=poner_aca_la_clave_anonima_publica

# --- URLs de la aplicación ---
VITE_APP_URL=https://alarma-vecinal.vercel.app

# --- Mercado Pago (solo pruebas al inicio) ---
# El access token NUNCA se usa en el frontend: se guarda como secreto de la
# Edge Function de suscripciones (supabase secrets set).
# MP_PUBLIC_ACCESS_TOKEN solo se usa en servidor/CI, jamás con prefijo VITE_.
